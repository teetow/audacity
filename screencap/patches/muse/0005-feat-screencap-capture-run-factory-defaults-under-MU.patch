From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Johan Althoff <teetow@gmail.com>
Date: Wed, 21 Oct 2026 15:10:09 +0200
Subject: [PATCH] feat(screencap): capture-run factory defaults under
 MUSE_SCREENCAP

Capture runs start from factory settings (-F) every time. With
MUSE_SCREENCAP set:

- dev mode defaults to off, so development builds show the release UI
  (no DevTools tab, no Diagnostics menu);
- update checks default to off, so repeated runs don't send an
  update-check request each time.

Without the variable nothing changes.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 framework/global/internal/globalconfiguration.cpp | 4 +++-
 framework/update/internal/updateconfiguration.cpp | 5 ++++-
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/framework/global/internal/globalconfiguration.cpp b/framework/global/internal/globalconfiguration.cpp
index e31a5affc..614e3db2c 100644
--- a/framework/global/internal/globalconfiguration.cpp
+++ b/framework/global/internal/globalconfiguration.cpp
@@ -50,7 +50,9 @@ static QString appInstallRoot()
 
 void GlobalConfiguration::init()
 {
-    settings()->setDefaultValue(DEV_MODE_ENABLED_KEY, Val(application()->unstable()));
+    //! NOTE Screen captures must look like the release: no dev-only UI under MUSE_SCREENCAP.
+    const bool screencap = qEnvironmentVariableIsSet("MUSE_SCREENCAP");
+    settings()->setDefaultValue(DEV_MODE_ENABLED_KEY, Val(application()->unstable() && !screencap));
     settings()->setDefaultValue(HIGH_RESOLUTION_TIMERS, Val(false));
 }
 
diff --git a/framework/update/internal/updateconfiguration.cpp b/framework/update/internal/updateconfiguration.cpp
index 6b0c5d875..b1eb40cc1 100644
--- a/framework/update/internal/updateconfiguration.cpp
+++ b/framework/update/internal/updateconfiguration.cpp
@@ -41,7 +41,10 @@ void UpdateConfiguration::init()
 {
     m_config = ConfigReader::read(":/configs/update.cfg");
 
-    settings()->setDefaultValue(CHECK_FOR_UPDATE_KEY, Val(isAppUpdatable()));
+    //! NOTE Capture runs start from factory settings every time; under MUSE_SCREENCAP
+    //! they must not send an update-check request each run.
+    const bool screencap = qEnvironmentVariableIsSet("MUSE_SCREENCAP");
+    settings()->setDefaultValue(CHECK_FOR_UPDATE_KEY, Val(isAppUpdatable() && !screencap));
     settings()->valueChanged(CHECK_FOR_UPDATE_KEY).onReceive(this, [this](const Val&) {
         m_needCheckForUpdateChanged.notify();
     });
