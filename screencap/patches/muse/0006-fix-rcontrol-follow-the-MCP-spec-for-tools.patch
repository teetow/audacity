 framework/rcontrol/mcp/mcpcontroller.h   |   5 +-
 framework/rcontrol/mcp/mcpserver.cpp     |  26 ++-
 framework/rcontrol/mcp/mcptypes.h        |   2 +
 4 files changed, 200 insertions(+), 31 deletions(-)

diff --git a/framework/rcontrol/mcp/mcpcontroller.cpp b/framework/rcontrol/mcp/mcpcontroller.cpp
