+ * it under the terms of the GNU General Public License version 3 as
+ * published by the Free Software Foundation.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#pragma once
+
+#include <QDir>
+#include <QString>
+
+namespace muse {
+//! MUSE_PROFILE_DIR keeps every per-user file of a run in one folder, for
+//! example a test or capture run that must not share state with the user:
+//! <dir>/roaming (settings), <dir>/local (app data), <dir>/documents (user data).
+//! Returns an empty string when the variable isn't set.
+inline QString profileSubdir(const char* sub)
+{
+    const QString dir = qEnvironmentVariable("MUSE_PROFILE_DIR");
+    return dir.isEmpty() ? QString() : QDir::cleanPath(dir + "/" + sub);
+}
+}
diff --git a/framework/global/settings.cpp b/framework/global/settings.cpp
index d41000df0..4c47c0ad5 100644
--- a/framework/global/settings.cpp
+++ b/framework/global/settings.cpp
@@ -21,6 +21,7 @@
  */
 
 #include "settings.h"
+#include "internal/profiledir.h"
 
 #include <QDateTime>
 #include <QSettings>
@@ -57,6 +58,13 @@ Settings::Settings()
     QSettings::setDefaultFormat(QSettings::IniFormat);
 #endif
 
+    const QString profileSettings = profileSubdir("roaming");
+    if (!profileSettings.isEmpty()) {
+        QSettings::setDefaultFormat(QSettings::IniFormat);
+        QSettings::setPath(QSettings::IniFormat, QSettings::UserScope, profileSettings);
+        QSettings::setPath(QSettings::IniFormat, QSettings::SystemScope, profileSettings);
+    }
+
     m_settings = new QSettings();
 }
 
@@ -244,7 +252,8 @@ QString Settings::dataPath() const
 #ifdef WIN_PORTABLE
     return QDir::cleanPath(QString("%1/../../../Data/settings").arg(QCoreApplication::applicationDirPath()));
 #else
-    return QStandardPaths::writableLocation(QStandardPaths::AppLocalDataLocation);
+    const QString profileData = profileSubdir("local");
+    return profileData.isEmpty() ? QStandardPaths::writableLocation(QStandardPaths::AppLocalDataLocation) : profileData;
 #endif
 }
 
